# Jekyll output and build caches
/_site/
/.sass-cache/
/.jekyll-cache/
/.jekyll-metadata

# Netlify CLI local state
/.netlify/

# Ruby/Bundler runtime files
/.bundle/
/vendor/
# Keep Gemfile.lock tracked for reproducible Netlify builds.

# Local secrets and credentials
.env
.env.*
!.env.example
!.env.*.example
/secrets/
*.pem
*.key
*.p12
*.pfx
*.keystore

# Generated caches
/.link_preview_cache.json
/_data/lqip.json

# Node/Python local dependencies and caches
/node_modules/
__pycache__/
*.py[cod]
/.venv/
/venv/

# Editors
/.vscode/
/.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.Spotlight-V100/
.Trashes/

# Logs and process state
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pid
*.pid.lock

# Temporary/local test files
/tmp/
/temp/
/local/
/scratch/
*.tmp
*.temp
task.md
walkthrough.md
